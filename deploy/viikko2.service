[Unit]
Description=Viikko 2 Flask-sovellus (Gunicorn)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/viikko2
EnvironmentFile=/home/ubuntu/viikko2/.env
ExecStart=/home/ubuntu/viikko2/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target


