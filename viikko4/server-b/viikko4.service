[Unit]
Description=Viikko 4 read-only replica page (Gunicorn)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/viikko4
EnvironmentFile=/home/ubuntu/viikko4/.env
ExecStart=/home/ubuntu/viikko2/venv/bin/gunicorn -w 2 -b 127.0.0.1:8001 app:app
Restart=always

[Install]
WantedBy=multi-user.target

